{
    "$schema": "https://raw.githubusercontent.com/pterodactyl/panel/2.0-develop/packages/sdk/manifest.schema.json",
    "id": "server-importer",
    "name": "Server File Importer",
    "version": "2.0.0",
    "description": "Seamlessly import game saves, world folders, plugins, mods, and entire server files directly from another Pterodactyl panel or remote server using SFTP credentials.",
    "author": "Azion",
    "icon": "icon.png",
    "requires": {
        "sdk": ">=2.0.0-beta.5 <3.0",
        "php": ">=8.2"
    },
    "provider": "ServerImporter\\ServerImporterProvider",
    "autoload": {
        "ServerImporter\\": "src"
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "imp",
        "screens": [
            {
                "id": "server-importer",
                "area": "server",
                "path": "import",
                "nav": {
                    "label": "Importer",
                    "order": 32,
                    "icon": "folder-input"
                }
            }
        ]
    }
}
